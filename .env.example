DB_PASSWORD=change-this-database-password
JWT_SECRET=change-this-with-at-least-48-random-characters-for-production
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081,http://192.168.1.215:8081
# Dirección que usarán los teléfonos. Reserva esta IP en el router antes de imprimir QR permanentes.
PUBLIC_BASE_URL=http://192.168.1.215:8081
SESSION_STALE_REVIEW_HOURS=12
SESSION_INACTIVITY_MINUTES=120
LAST_GUEST_GRACE_MINUTES=5
# En producción: true, false y credenciales iniciales seguras (solo se usan con una BD vacía).
PRODUCTION_MODE=false
DEMO_DATA_ENABLED=true
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=change-this-in-production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
